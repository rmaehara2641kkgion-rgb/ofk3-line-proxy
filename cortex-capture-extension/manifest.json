{
  "manifest_version": 3,
  "name": "OFK3 Cortex Capture",
  "version": "1.6.17",
  "description": "Capture Cortex SPA route JSON locally. Does not read cookies or send data. Mentor Sensor v1 observes Mentor shift GETs and can send the Active snapshot to OFK3. A local Scheduling/Mentor ID diagnostic stays in the browser. The OFK3 delivery page local master can be counted in that same browser.",
  "action": {
    "default_title": "OFK3取得"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://logistics.amazon.co.jp/*",
    "https://logistics.amazon.com/*",
    "https://vrm-mentor.edriving.com/*",
    "https://ofk3-line-proxy-1.onrender.com/*",
    "https://ofk3-cortex-preview.onrender.com/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://logistics.amazon.co.jp/*",
        "https://logistics.amazon.com/*"
      ],
      "js": [
        "phase1-core.js",
        "phase1-runner.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://logistics.amazon.co.jp/*",
        "https://logistics.amazon.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://logistics.amazon.co.jp/scheduling/*"
      ],
      "js": [
        "id-diag-core.js",
        "scheduling-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://logistics.amazon.co.jp/scheduling/*"
      ],
      "js": [
        "scheduling-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://vrm-mentor.edriving.com/*"
      ],
      "js": [
        "id-diag-core.js",
        "mentor-capture.js",
        "id-diag-panel.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://vrm-mentor.edriving.com/*"
      ],
      "js": [
        "mentor-bridge.js",
        "mentor-diag-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://ofk3-line-proxy-1.onrender.com/index.html",
        "https://ofk3-line-proxy-1.onrender.com/"
      ],
      "js": [
        "master-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://ofk3-line-proxy-1.onrender.com/index.html",
        "https://ofk3-line-proxy-1.onrender.com/"
      ],
      "js": [
        "master-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
